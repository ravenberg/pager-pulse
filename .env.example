# Copy to .env next to this file. pm2 loads it when it starts the app.

# Required in production. Generate each with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_KEY=
JWT_SECRET=

# The address people use, for absolute links (status emails, invitations).
APP_URL=https://pagerpulse.example.com

# The port Caddy proxies to. The docs use 3001.
PORT=3002

# Where the data lives. ops/reset.sh wipes both every night.
DATABASE_PATH=data/pager-pulse.sqlite
STORAGE_PATH=data/storage

# Optional: send status emails over SMTP instead of logging them.
# MAIL_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="PagerPulse <status@example.com>"
